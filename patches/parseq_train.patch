+class PadResize:
+    """Aspect-preserving resize: scale the image to fit inside (H, W) without distortion, then pad the right and bottom
+    with the image's median colour up to exactly (H, W). Text stays left-aligned at full height."""
+
+    def __init__(self, img_size, interpolation=T.InterpolationMode.BICUBIC):
+        self.h, self.w = img_size
+        self.interpolation = interpolation
+
+    def __call__(self, img):
+        from PIL import Image
+
+        w, h = img.size
+        scale = min(self.h / h, self.w / w)
+        nw, nh = max(1, round(w * scale)), max(1, round(h * scale))
+        img = T.functional.resize(img, [nh, nw], self.interpolation)
+        arr = np.asarray(img)
+        fill = tuple(int(v) for v in np.median(arr.reshape(-1, arr.shape[-1] if arr.ndim == 3 else 1), axis=0))
+        canvas = Image.new(img.mode, (self.w, self.h), fill if img.mode != 'L' else fill[0])
+        canvas.paste(img, (0, 0))
+        return canvas
+
+
+def make_resize(img_size, mode='stretch'):
+    """'stretch' = PARSeq default (distorts aspect ratio); 'pad' = aspect-preserving resize + padding."""
+    if mode == 'pad':
+        return PadResize(img_size)
+    if mode != 'stretch':
+        raise ValueError(f'unknown resize_mode {mode!r}')
+    return T.Resize(img_size, T.InterpolationMode.BICUBIC)
+
